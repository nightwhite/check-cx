---
import { DashboardIsland } from "../components/dashboard/dashboard-island";
import { NotificationBanner } from "../../components/notification-banner";
import "../styles/global.css";
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // 被其他站点以 iframe 内嵌时标记根元素，样式据此隐藏文档滚动条（滚动仍可用）。
      (function () {
        try {
          if (window.self !== window.top) {
            document.documentElement.setAttribute("data-embedded", "");
          }
        } catch (error) {
          document.documentElement.setAttribute("data-embedded", "");
        }
      })();
      (function () {
        var media = window.matchMedia
          ? window.matchMedia("(prefers-color-scheme: dark)")
          : null;
        function readTheme() {
          try {
            var value = window.localStorage.getItem("theme");
            return value === "light" || value === "dark" ? value : "system";
          } catch (error) {
            return "system";
          }
        }
        function apply() {
          var theme = readTheme();
          var isDark =
            theme === "dark" || (theme === "system" && !!media && media.matches);
          var root = document.documentElement;
          root.classList.toggle("dark", isDark);
          root.style.colorScheme = isDark ? "dark" : "light";
        }
        apply();
        if (media) {
          var onChange = function () {
            if (readTheme() === "system") {
              apply();
            }
          };
          if (media.addEventListener) {
            media.addEventListener("change", onChange);
          } else if (media.addListener) {
            media.addListener(onChange);
          }
        }
      })();
    </script>
    <!-- 标题、描述与 favicon 版本号由 Worker 按后台站点配置替换，见 src/worker/pages/index-html.ts -->
    <title>SU8 Status</title>
    <meta
      name="description"
      content="SU8 AI provider health status"
    />
    <link rel="icon" href="/favicon.ico?v=site" sizes="any" />
  </head>
  <body>
    <NotificationBanner client:load />
    <main class="min-h-screen w-full px-4 py-6 sm:px-6 md:py-8 lg:px-10">
      <DashboardIsland client:load />
    </main>
  </body>
</html>
