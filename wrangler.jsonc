{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "check-cx-workers",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-05-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["*/1 * * * *"]
  }
}
